POSTGRES_DB=agentgo
POSTGRES_USER=agentgo
POSTGRES_PASSWORD=agentgo-local
POSTGRES_PORT=5432
AGENTGO_APP_PORT=8080
OPENAI_API_KEY=local-development-key

# Authentik OIDC client settings for the AgentGo backend.
AGENTGO_OIDC_AUTHORIZATION_URI=http://localhost:9000/application/o/authorize/
AGENTGO_OIDC_TOKEN_URI=http://host.docker.internal:9000/application/o/token/
AGENTGO_OIDC_JWK_SET_URI=http://host.docker.internal:9000/application/o/agentgo/jwks/
AGENTGO_OIDC_USER_INFO_URI=http://host.docker.internal:9000/application/o/userinfo/
AGENTGO_OIDC_CLIENT_ID=agentgo
AGENTGO_OIDC_CLIENT_SECRET=replace-with-the-confidential-client-secret
AGENTGO_UI_BASE_URL=http://localhost:5173
AGENTGO_AUTHENTIK_BROWSER_BASE_URL=http://localhost:9000
AGENTGO_OPENAPI_TITLE=AgentGo API
AGENTGO_OPENAPI_DESCRIPTION=AgentGo backend service API
AGENTGO_OPENAPI_VERSION=v1
AGENTGO_OPENAPI_TERMS_URL=
AGENTGO_OPENAPI_CONTACT_NAME=AgentGo Team
AGENTGO_OPENAPI_CONTACT_URL=https://github.com/Martin-WMM/AgentGo-backend
AGENTGO_OPENAPI_CONTACT_EMAIL=
AGENTGO_OPENAPI_LICENSE_NAME=Apache License 2.0
AGENTGO_OPENAPI_LICENSE_URL=https://www.apache.org/licenses/LICENSE-2.0
AGENTGO_OPENAPI_SERVER_URL=
AGENTGO_OPENAPI_SERVER_DESCRIPTION=
AGENTGO_AUTHENTIK_API_BASE_URL=http://host.docker.internal:9000
# Create an Authentik API token with permission to manage users. Keep it local.
AGENTGO_AUTHENTIK_API_TOKEN=
MINIO_ENDPOINT=http://host.docker.internal:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local-minio-password-change-me
MINIO_BUCKET=agentgo-bucket
