# Copy to terraform.tfvars locally, or pass variables through CI secrets.
# terraform.tfvars is ignored by Git.
authentik_url = "http://localhost:9000"

# Do not put the API token in this file. Prefer:
#   $env:AUTHENTIK_TOKEN = "..."
authentik_token = "replace-me"

# Defaults in variables.tf already cover:
#   dev  — authorize :8080, logout :5173/?signedOut=1
#   local — authorize :20082, logout :20080/?signedOut=1
#   test — authorize/logout via :28080/backend and :28080/ui
# Override redirect_uris here only when DEPLOY_HOST or ports differ.
ui_base_url = "http://localhost:5173"
