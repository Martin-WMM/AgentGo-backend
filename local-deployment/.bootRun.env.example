# Dev environment: host bootRun (:8080) + Vite UI (:5173).
# Copy to .bootRun.env (gitignored) and fill AGENTGO_OIDC_CLIENT_SECRET.
# Shared infra still comes from Compose without the "local" profile:
#   docker compose up -d
# Do not export these into the shell when running full Compose "local" profile,
# or Compose will inherit the wrong UI_BASE_URL / ports.

DATABASE_URL=jdbc:postgresql://localhost:5433/agentgo
DATABASE_USERNAME=agentgo
DATABASE_PASSWORD=agentgo-local
AGENTGO_OIDC_AUTHORIZATION_URI=http://localhost:9000/application/o/authorize/
AGENTGO_OIDC_TOKEN_URI=http://localhost:9000/application/o/token/
AGENTGO_OIDC_JWK_SET_URI=http://localhost:9000/application/o/agentgo/jwks/
AGENTGO_OIDC_USER_INFO_URI=http://localhost:9000/application/o/userinfo/
AGENTGO_OIDC_CLIENT_ID=agentgo
AGENTGO_OIDC_CLIENT_SECRET=replace-with-the-confidential-client-secret
AGENTGO_UI_BASE_URL=http://localhost:5173
AGENTGO_AUTHENTIK_BROWSER_BASE_URL=http://localhost:9000
AGENTGO_AUTHENTIK_API_BASE_URL=http://localhost:9000
# Create in Authentik: Directory → Tokens (intent API), then paste here.
AGENTGO_AUTHENTIK_API_TOKEN=
# Use 127.0.0.1 on Windows; localhost may resolve to IPv6 and time out against MinIO.
MINIO_ENDPOINT=http://127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local-minio-password-change-me
MINIO_BUCKET=agentgo-bucket
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
TRACING_SAMPLING_PROBABILITY=0.0
