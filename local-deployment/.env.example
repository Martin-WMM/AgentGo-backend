# Authentik image version. Keep server and worker on the same version.
AUTHENTIK_VERSION=2026.8.3

# Authentik PostgreSQL. Replace PG_PASS before any non-local deployment.
PG_DB=authentik
PG_USER=authentik
PG_PASS=local-authentik-postgres-password

# Generate a unique value for real environments:
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=local-authentik-secret-key-change-me

# Local host ports for the Docker Compose stack.
# Host IDE / Vite use 8080 + 5173 via .bootRun.env instead.
AGENTGO_UI_PORT=20080
AGENTGO_APP_PORT=20082
AGENTGO_POSTGRES_PORT=5433
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
AGENTGO_UI_BUILD_CONTEXT=../../AgentGo-UI
VITE_AGENTGO_BACKEND_URL=http://localhost:20082

# AgentGo application PostgreSQL (host port AGENTGO_POSTGRES_PORT).
AGENTGO_POSTGRES_DB=agentgo
AGENTGO_POSTGRES_USER=agentgo
AGENTGO_POSTGRES_PASSWORD=agentgo-local

# SMTP settings used by Authentik enrollment and password recovery flows.
AUTHENTIK_EMAIL__HOST=mail.example.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=agentgo@example.com
AUTHENTIK_EMAIL__PASSWORD=change-me
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=AgentGo <agentgo@example.com>

# MinIO object storage. Keep the root password outside Git and change it before use.
MINIO_IMAGE=alpine/minio
MINIO_VERSION=latest-release
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=local-minio-password-change-me
MINIO_BUCKET=agentgo-bucket

# Authentik OIDC client settings for the AgentGo backend.
# OIDC: browser uses localhost:9000; Compose app uses authentik-oidc (Host rewrite)
# so ID token iss stays http://localhost:9000/... and logout id_token_hint validates.
# Dev bootRun (.bootRun.env) talks to localhost:9000 directly from the host.
AGENTGO_OIDC_AUTHORIZATION_URI=http://localhost:9000/application/o/authorize/
AGENTGO_OIDC_TOKEN_URI=http://authentik-oidc:9000/application/o/token/
AGENTGO_OIDC_JWK_SET_URI=http://authentik-oidc:9000/application/o/agentgo/jwks/
AGENTGO_OIDC_USER_INFO_URI=http://authentik-oidc:9000/application/o/userinfo/
AGENTGO_OIDC_CLIENT_ID=agentgo
AGENTGO_OIDC_CLIENT_SECRET=replace-with-the-confidential-client-secret
AGENTGO_UI_BASE_URL=http://localhost:20080
AGENTGO_AUTHENTIK_BROWSER_BASE_URL=http://localhost:9000
AGENTGO_AUTHENTIK_API_BASE_URL=http://authentik-oidc:9000
AGENTGO_AUTHENTIK_API_TOKEN=
