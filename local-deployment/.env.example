# Authentik image version. Keep server and worker on the same version.
AUTHENTIK_VERSION=2026.8.3

# PostgreSQL settings. Replace PG_PASS before any non-local deployment.
PG_DB=authentik
PG_USER=authentik
PG_PASS=local-authentik-postgres-password

# Generate a unique value for real environments:
# openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=local-authentik-secret-key-change-me

# Local host ports.
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# SMTP settings used by Authentik enrollment and password recovery flows.
# Replace these values before testing registration or password reset emails.
AUTHENTIK_EMAIL__HOST=mail.example.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=agentgo@example.com
AUTHENTIK_EMAIL__PASSWORD=change-me
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__FROM=AgentGo <agentgo@example.com>

# MinIO object storage. Keep the root password outside Git and change it before use.
MINIO_IMAGE=alpine/minio
MINIO_VERSION=latest-release
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-minio-password-change-me
MINIO_API_PORT=9001
MINIO_CONSOLE_PORT=9002
