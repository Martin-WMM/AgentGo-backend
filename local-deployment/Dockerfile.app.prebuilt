# Local Compose image from a host-built bootJar (avoids in-container plugin downloads).
FROM eclipse-temurin:25-jre

# Python 3 for AgentGo Bash / CLI tool script execution in local Compose.
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY agentgo-app.jar /app/agentgo-app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/agentgo-app.jar"]
